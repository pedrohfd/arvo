{
	"name": "server",
	"type": "module",
	"main": "src/index.ts",
	"scripts": {
		"build": "tsdown",
		"check-types": "tsc --noEmit",
		"compile": "bun build --compile --no-compile-autoload-dotenv --minify --sourcemap --bytecode ./src/index.ts --outfile server",
		"dev": "bun run --hot src/index.ts",
		"start": "bun run dist/index.mjs",
		"env:generate": "varlock codegen",
		"auth:generate": "varlock run -- bun x auth@latest generate --config src/services.ts --output ../../packages/db/prisma/schema/auth.prisma --yes"
	},
	"dependencies": {
		"@arvo/api": "workspace:*",
		"@arvo/auth": "workspace:*",
		"@arvo/db": "workspace:*",
		"@fastify/cors": "^11.3.0",
		"@hono/trpc-server": "^0.4.2",
		"@trpc/server": "catalog:",
		"better-auth": "catalog:",
		"fastify": "^5.12.3",
		"varlock": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@arvo/config": "workspace:*",
		"@types/bun": "catalog:",
		"tsdown": "^0.23.0",
		"typescript": "catalog:"
	}
}
